# Copia a .env antes de levantar: cp .env.example .env

# Nombre real de la red Docker del stack raíz de GameMetrics.
# Por defecto docker compose la nombra "<carpeta>_<red>" -> "gamemetrics_gamemetrics".
# Verifica con: docker network ls | findstr gamemetrics
GAMEMETRICS_NETWORK=gamemetrics_gamemetrics

# Cambiar en cualquier despliegue que no sea localhost de demo académica.
AIRFLOW_SECRET_KEY=gamemetrics_dev_secret_change_me
