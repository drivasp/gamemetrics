# Apache Pinot
PINOT_BROKER_URL=http://localhost:8099
PINOT_CONTROLLER_URL=http://localhost:9000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Autenticación
JWT_SECRET=cambia_este_secreto_en_produccion

# RAWG API — https://rawg.io/apidocs
RAWG_API_KEY=

# Frontend (URLs de redirección Stripe)
FRONTEND_URL=http://localhost:4000

# Stripe sandbox — https://stripe.com/docs/keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Revenue share: flat (default, % por partner) | steam_tiers (30/25/20)
REVENUE_SHARE_MODE=flat
# RS_TIER_10M_USD=10000000
# RS_TIER_50M_USD=50000000
# RS_TAKE_BELOW_10M=30
# RS_TAKE_10M_50M=25
# RS_TAKE_ABOVE_50M=20

# Steam Direct Fee equivalente (0 = desactivado)
PUBLICATION_FEE_USD=100
PUBLICATION_FEE_RECOUP_USD=1000

# Payouts (Steam-like): hold + mínimo
# Steam oficial: mínimo $100; pago ~30 días después del mes de venta
# https://partner.steamgames.com/doc/finance/payments_salesreporting
PAYOUT_MIN_USD=10
# Hold alineado a ventana de reembolso (14 días) — prod Steam-like
PAYOUT_HOLD_MS=1209600000

# FINANCIAL_LEDGER_PATH
FINANCIAL_LEDGER_PATH=./data/financial_ledger.sqlite3


# Object storage (MinIO) — builds de juegos
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=gamemetrics
MINIO_SECRET_KEY=gamemetrics_secret
MINIO_BUCKET=gamemetrics-builds
MINIO_SECURE=false
LOCAL_BUILD_DIR=/app/static/builds

# Opcional: directorio de avatares (default en contenedor: /app/static/avatars)
# AVATAR_DIR=/app/static/avatars
