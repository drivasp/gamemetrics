# Apache Pinot
PINOT_BROKER_URL=http://localhost:8099
PINOT_CONTROLLER_URL=http://localhost:9000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Autenticación
JWT_SECRET=cambia_este_secreto_en_produccion

# RAWG API — https://rawg.io/apidocs
RAWG_API_KEY=

# Frontend (URLs de redirección Stripe)
FRONTEND_URL=http://localhost:4000

# Stripe sandbox — https://stripe.com/docs/keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payouts (Steam-like): hold + mínimo
# Steam prod ~$100; en dev usamos $10 para poder probar
PAYOUT_MIN_USD=10
# Hold alineado a ventana de reembolso (14 días)
PAYOUT_HOLD_MS=1209600000

# Featured placement SaaS
FEATURED_PLACEMENT_USD=49
FEATURED_PLACEMENT_DAYS=7

# Object storage (MinIO) — builds de juegos
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=gamemetrics
MINIO_SECRET_KEY=gamemetrics_secret
MINIO_BUCKET=gamemetrics-builds
MINIO_SECURE=false
LOCAL_BUILD_DIR=/app/static/builds

# Opcional: directorio de avatares (default en contenedor: /app/static/avatars)
# AVATAR_DIR=/app/static/avatars
